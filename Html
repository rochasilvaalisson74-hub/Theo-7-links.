      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      width: 100%;
      padding: 19px 16px;
      margin: 16px 0;
      border-radius: 14px;
      text-decoration: none;
      font-size: 15px;
      font-weight: bold;
      letter-spacing: 1px;
      transition: transform .2s, box-shadow .2s;
    }

    .link:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 30px #9b38ff55;
    }

    .primary {
      color: white;
      background: linear-gradient(110deg, #7224c9, #a43dff);
      border: 1px solid #c68bff;
      box-shadow: 0 0 24px #8a2be944;
    }

    .secondary {
      color: white;
      background: #171020;
      border: 1px solid #8e42c9;
    }

    .icon {
      font-size: 23px;
    }

    .footer {
      margin-top: 35px;
